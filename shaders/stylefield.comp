#version 460 core
layout(local_size_x = 16, local_size_y = 16) in;

#include "common.glsl"
#include "style.glsl"

// brushkit fields.py on the GPU: the painter's hand logic, written into the
// direction field trace.comp already follows. Runs per layer, after Sobel /
// structure tensor / ETF have built the image's own flow, so every style field
// can defer to the motif where the motif has something to say.
//
// Output keeps trace.comp's contract: (gx, gy, gmag) with the stroke going
// along perp(g) = (-gy, gx). A style field writes g = (sin a, -cos a) * M so
// that perp(g) points along angle a. Pattern modes floor M at minFieldMag so
// their strokes continue across flat regions. Follow image preserves the
// source field and its gradient termination rule.
//
// Orientations are blended in doubled-angle form, so a and a + pi count as the
// same direction, exactly like fields.py.

layout(binding = 0) uniform sampler2D uGrad;
layout(rgba16f, binding = 0) uniform writeonly image2D uOut;

const float PI = 3.14159265;

vec2 d2(float a) { return vec2(cos(2.0 * a), sin(2.0 * a)); }

// Orthogonal axes can cancel in doubled-angle space. Keep the incoming
// direction at that tie rather than let round-off or atan(0, 0) choose it.
float axisAngle(vec2 axis, float incoming) {
    if (dot(axis, axis) < 1e-12) return incoming;
    return 0.5 * atan(axis.y, axis.x);
}

float imgAngle(ivec2 q, out float mag) {
    ivec2 size = ivec2(IMG_SIZE);
    vec3 g = texelFetch(uGrad, clamp(q, ivec2(0), size - 1), 0).rgb;
    mag = g.z;
    if (dot(g.xy, g.xy) == 0.0) return 0.0;
    return atan(g.x, -g.y);   // angle of perp(g) = (-gy, gx)
}

float curlAngle(vec2 p) {
    float sc = max(ST_CURL_SCALE, 4.0);
    float e = 1.0;
    float dx = fbm((p + vec2(e, 0.0)) / sc, 3, 601u) - fbm((p - vec2(e, 0.0)) / sc, 3, 601u);
    float dy = fbm((p + vec2(0.0, e)) / sc, 3, 601u) - fbm((p - vec2(0.0, e)) / sc, 3, 601u);
    if (dx == 0.0 && dy == 0.0) return 0.0; // curl stagnation point
    return atan(-dx, dy);     // streamline of the stream function: (dpsi/dy, -dpsi/dx)
}

float fallbackAngle(vec2 p) {
    int m = int(ST_FALLBACK_MODE + 0.5);
    if (m == 1) return curlAngle(p);
    if (m == 2) return 0.0;
    return radians(ST_FALLBACK_ANGLE);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(IMG_SIZE);
    if (px.x >= size.x || px.y >= size.y) return;
    vec2 p = vec2(px) + 0.5;

    int mode = int(ST_FIELD_MODE + 0.5);
    float mixW = clamp(ST_FIELD_MIX, 0.0, 1.0);
    vec4 source = texelFetch(uGrad, px, 0);
    if (mode == 0 || mixW == 0.0) {
        // Follow image is the source field itself. A weak Sobel magnitude
        // still gives a valid tangent: blending it with a fixed fallback
        // made soft gradients converge on the same diagonal for every brush.
        // Keep its magnitude too, so the trace's gradient floor and curvature
        // weighting behave exactly as they do with the classic tile brush.
        vec4 g = source;
        float rotation = layerB().z;
        if (ST_PERTURB > 0.0)
            rotation += ST_PERTURB * fbm(p / max(ST_PERTURB_SCALE, 4.0), 3, 621u);
        if (rotation != 0.0) {
            float cs = cos(rotation), sn = sin(rotation);
            g.xy = vec2(g.x * cs - g.y * sn, g.x * sn + g.y * cs);
        }
        // In a truly flat region there is no image direction to follow.
        // Preserve that zero instead of inventing a full-length diagonal.
        imageStore(uOut, px, g);
        return;
    }

    float mag;
    float aImg = imgAngle(px, mag);
    // Pattern strength blends from the actual image direction. Confidence
    // limits the curl/wave patterns below; it must not replace a resolvable
    // source tangent with the fallback angle before that blend even starts.
    float conf = clamp(mag / max(ST_COHERENCE_MIN, 1e-4), 0.0, 1.0);
    bool hasImage = dot(source.xy, source.xy) > 0.0;
    float incoming = hasImage ? aImg : fallbackAngle(p);
    vec2 acc = d2(incoming);

    if (mode == 1) {
        // Turner: tangential flow around the eye, tilted inward so it spirals
        // rather than rings, fading back to the motif's flow with distance.
        vec2 c = ST_VORTEX * IMG_SIZE;
        vec2 dv = p - c;
        dv.y /= 1.1;
        float r = length(dv) / max(IMG_SIZE.x, IMG_SIZE.y);
        float a = incoming; // the exact eye has no tangential direction
        if (dot(dv, dv) > 0.0)
            a = atan(dv.y, dv.x) + 0.5 * PI + ST_VORTEX_SPIRAL;
        float wv = exp(-pow(r / max(ST_VORTEX_RADIUS, 1e-3), 2.0)) * mixW;
        float w = 0.05 * mixW + 0.9 * wv;
        acc = mix(acc, d2(a), w);
    } else if (mode == 2) {
        // Cezanne: piecewise-constant over Voronoi patches. Every hatch inside
        // one patch takes the angle the flow has at the patch's seed.
        float cell = max(ST_PATCH_CELL, 2.0);
        uint id; vec2 fp;
        worley(p / cell, 701u, id, fp);
        ivec2 sp = ivec2(fp * cell);
        float ms;
        float as_ = imgAngle(sp, ms);
        float cs = clamp(ms / max(ST_COHERENCE_MIN, 1e-4), 0.0, 1.0);
        vec2 sd = d2(as_) * cs + d2(fallbackAngle(vec2(sp))) * (1.0 - cs);
        vec2 seedGrad = texelFetch(uGrad, clamp(sp, ivec2(0), size - 1), 0).xy;
        float seedAngle = dot(seedGrad, seedGrad) > 0.0 ? as_ : fallbackAngle(vec2(sp));
        float a = axisAngle(sd, seedAngle);
        a += (hash01(id) * 2.0 - 1.0) * ST_PATCH_JITTER;
        if (ST_PATCH_QUANT > 0.0) a = floor(a / ST_PATCH_QUANT + 0.5) * ST_PATCH_QUANT;
        acc = mix(acc, d2(a), mixW);
    } else if (mode == 3) {
        // Van Gogh sky: turbulence wherever the motif itself is flat.
        acc = mix(acc, d2(curlAngle(p)), mixW * (1.0 - conf));
    } else if (mode == 4) {
        // Munch: the whole world pulled into undulating bands.
        float lam = max(ST_WAVE_LEN, 4.0);
        vec2 dir = vec2(cos(ST_WAVE_ANGLE), sin(ST_WAVE_ANGLE));
        float ph = 2.0 * PI * dot(p, dir) / lam;
        float wob = 2.0 * fbm(p / (lam * 2.0), 3, 611u);
        float a = ST_WAVE_ANGLE + ST_WAVE_AMP * sin(ph + wob) * 0.6;
        acc = mix(acc, d2(a), mixW * (1.0 - conf));
    } else if (mode == 5) {
        acc = mix(acc, d2(radians(ST_FALLBACK_ANGLE)), mixW);
    }

    float ang = axisAngle(acc, incoming);
    // Doubled angles describe an unoriented axis. Choose the sign nearest the
    // source vector so a tiny pattern amount cannot reverse the initial walk.
    if (hasImage && dot(vec2(sin(ang), -cos(ang)), source.xy) < 0.0) ang += PI;
    ang += layerB().z;   // e.g. pastel cross-hatching
    if (ST_PERTURB > 0.0) ang += ST_PERTURB * fbm(p / max(ST_PERTURB_SCALE, 4.0), 3, 621u);

    // A vanishing pattern strength also converges to the source magnitude
    // and curvature weight (tensor directions may be unit length while .z is
    // small). Only the chosen pattern supplies paint flow in flat regions.
    float patternMag = max(mag, ST_MIN_FIELD_MAG);
    float vectorLen = mix(length(source.xy), patternMag, mixW);
    float M = mix(mag, patternMag, mixW);
    imageStore(uOut, px, vec4(sin(ang) * vectorLen, -cos(ang) * vectorLen, M, 0.0));
}
